{
  "redirects": [
    {
      "//": "www→apex is now done client-side (see src/pwa.ts). The old server-side 308 blocked service-worker updates at www — /sw.js there returned a 3xx, which the SW update spec treats as a network error, so users stayed pinned to a stale precache. Serving the app at both hosts lets the SW at www update itself; the client-side redirect then bounces the fresh page to apex. Canonical tag in index.html preserves the SEO signal to apex in the meantime.",
      "source": "/:route(app|download)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*android.*"
        }
      ],
      "destination": "https://play.google.com/store/apps/details?id=app.lishka.mobile",
      "permanent": false
    },
    {
      "source": "/:route(app|download)",
      "destination": "https://apps.apple.com/us/app/lishka/id6767207290",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/workbox-(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
